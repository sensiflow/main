# Sensiflow Hub Configuration
# This file contains configuration settings for the hub manager

# Organization settings
ORG_NAME=sensiflow
GITHUB_BASE_URL=https://github.com/${ORG_NAME}

# Repository list (space-separated)
REPOS="sensi-web-api sensi-web instance-manager"

# Build settings
WEB_BUILD_COMMAND="npm run build"
API_BUILD_COMMAND="./gradlew bootJar"

# Docker settings
COMPOSE_FILE=docker-compose.yml
TEST_COMPOSE_FILE=docker-compose.test.yml

# Port mappings for services
WEB_PORT=80
API_PORT=8090
DB_ADMIN_PORT=8081
RABBITMQ_MANAGEMENT_PORT=15672

# Deployment options
DEFAULT_BUILD_BEFORE_DEPLOY=true
DEFAULT_FORCE_CLONE=false

# Logging settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
COLORED_OUTPUT=true